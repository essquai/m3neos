%
% This cfg was adapted from three cm3 config files:
%     * AMD64_LINUX
%     * AMD64.common
%     * Linux.common
%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%
% wasm32
%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

SYSROOT = "/opt/wasi-sysroot-24.0"
CC_FLAGS = " --target=wasm32-wasip1-threads"
  & " --sysroot=" & SYSROOT
  & " -pthread -matomics"
  & " -D_WASI_EMULATED_SIGNAL -D_WASI_EMULATED_MMAN"
  & " -mexception-handling"

SYSTEM_CC   = "clang -g" & CC_FLAGS
SYSTEM_CXXC = "clang++ -g" & CC_FLAGS

readonly SYSTEM_ASM = "clang --target=wasm32-wasip1-threads" % Assembler

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%
% AMD64.common
%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
readonly TARGET_ARCH = "wasm32"
readonly TARGET_ENDIAN = "LITTLE"   % { "BIG" OR "LITTLE" }
readonly WORD_SIZE = "32BITS"       % { "32BITS" or "64BITS" }
M3_PARALLEL_BACK = 20 % modern machines usually have many cores

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%
% Linux.common
% Copyright 1996 Critical Mass, Inc. All rights reserved.
%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

readonly TARGET_OS = "POSIX"

M3_MAIN_M3CC = TRUE

if not defined ("SYSTEM_CXXXC")
   SYSTEM_CXXXC = SYSTEM_CC
end

% use the gold linker for large links in preference to the system linker
% if you have lld installed it is better still
%LD_PREF = " "
%LD_PREF = " -fuse-ld=gold"
LD_PREF = " -fuse-ld=lld"

if not defined ("MAX_MEMORY")
  MAX_MEMORY = "33554432"
end


WASI_LIBS = " -lwasi-emulated-signal -lwasi-emulated-mman -lwasi-emulated-getpid"
SYSTEM_LD = SYSTEM_CXXXC
  & LD_PREF
  & " -Wl,--fatal-warnings"
  & " -Wl,--shared-memory,--import-memory,--max-memory=" & MAX_MEMORY
  & WASI_LIBS

% disable shared libraries for wasm32
proc AdjustShared(shared) is
  return FALSE
end

% PIC would make every module import __memory_base,
% wasm-ld does not define it for static linking
llvmback_pic = "-relocation-model=static"

% Must match the C side (-pthread -matomics): wasm-ld --shared-memory rejects
% objects built without atomics/bulk-memory.
llvmback_features = "-mattr=+atomics,+bulk-memory,+mutable-globals"

include("Unix.common")

