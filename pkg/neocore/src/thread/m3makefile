include_dir ("Common")

if not defined ("THREAD")
  THREAD = "default"
end

% FreeBSD 4 or earlier might not have a viable pthreads,
% in which case make a separate config file and set NOPTHREAD = TRUE or such.
%
if equal (OS_TYPE, "WIN32") or equal (TARGET_OS, "CYGWIN")
  include_dir ("WIN32")
else
  if equal (TARGET, "wasm32") or equal (THREAD, "W")
    include_dir("WTHREAD")
  else
    if equal (THREAD, "P") or not defined ("NOPTHREAD")
      THREAD = "P"
      include_dir("PTHREAD")
    else
      include_dir (OS_TYPE)
    end
  end
end
